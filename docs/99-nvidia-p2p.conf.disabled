# P2P entre GPUs de consumo (2026-08-17).
#
# ForceP2P es NV_REG_STR_CL_FORCE_P2P (nvrm_registry.h:1082). Layout:
#   READ    bits 1:0  ENABLE=1
#   WRITE   bits 5:4  ENABLE=1
#   ATOMICS bits 9:8  DEFAULT=2
# 0x211 = 529 = READ_ENABLE | WRITE_ENABLE | ATOMICS_DEFAULT, que es
# exactamente el p2pOverride que hardcodea el fork aikitoria/open-gpu-kernel-modules.
# El driver stock YA lee esta clave (osReadRegistryDword en _kbifInitRegistryOverrides),
# asi que no hace falta recompilar. Sin la rama _PCIE_BAR1 que agrega el fork,
# el driver stock cae a kbusCreateP2PMappingForMailbox_HAL: P2P por MAILBOX,
# que NO necesita BAR1 grande (la Zotac esta clavada en 256 MB por firmware).
#
# Para revertir: borrar este archivo y recargar los modulos nvidia.
options nvidia NVreg_RegistryDwords="ForceP2P=529"
