# Plantilla de credenciales para los composes de este directorio.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# Docker Compose lee `.env` automáticamente por estar acá: no hay que pasarle
# --env-file. Guía completa: ../docs/ENV-SETUP.md
#
# ⚠️ `.env` NO se versiona. `.env.example` (este archivo) sí, y por eso no debe
#    tener ningún valor real.

# ── REQUERIDO ────────────────────────────────────────────────────────────────
# Clave de la API de vLLM. Los clientes la mandan como Authorization: Bearer.
# Si el engine sale a internet vía Traefik/Cloudflare, es lo único que protege
# tu GPU. Generá una de verdad:   openssl rand -hex 32
VLLM_API_KEY=CAMBIAME-openssl-rand-hex-32

# ── OPCIONAL: HuggingFace ────────────────────────────────────────────────────
# Solo para bajar checkpoints privados o gated. Si los pesos ya están en
# models-cache, dejalas vacías. Token: https://huggingface.co/settings/tokens
# Ambas llevan EL MISMO valor (distintas versiones leen una u otra).
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# ── OPCIONAL: DNS interno de la red Docker ───────────────────────────────────
# Solo si los contenedores necesitan resolverse entre sí por nombre.
AI_DNS_SERVER=

# ── OPCIONAL: solo para composes que no son de vLLM ──────────────────────────
# WEBUI_SECRET_KEY=        # open-webui, firma de sesiones
# OPEN_TERMINAL_API_KEY=   # open-terminal
